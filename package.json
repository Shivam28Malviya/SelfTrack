{
  "name": "team-pulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "test": "node --test 'tests/*.test.mjs'",
    "db:seed:tp": "node --env-file-if-exists=.env.local scripts/seed-teampulse.mjs",
    "build:migrations": "node scripts/build-migrations.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "dev:server": "node --env-file-if-exists=.env.local scripts/dev-server.mjs",
    "dev:full": "npm run build && node --env-file-if-exists=.env.local scripts/dev-server.mjs",
    "db:admin": "node --env-file-if-exists=.env.local scripts/make-admin.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "@supabase/supabase-js": "^2.110.8",
    "bcryptjs": "^2.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.9",
    "vite": "^5.4.0",
    "wrangler": "^4.134.0"
  }
}
