{
  "name": "team-pulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Delivery, client impact, attendance and growth for a team, in one place.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:server": "node --env-file-if-exists=.env.local scripts/dev-server.mjs",
    "dev:full": "npm run build && node --env-file-if-exists=.env.local scripts/dev-server.mjs",
    "test": "node --test 'tests/*.test.mjs'",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "db:admin": "node --env-file-if-exists=.env.local scripts/make-admin.mjs",
    "build:migrations": "node scripts/build-migrations.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "bcryptjs": "^2.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "pg": "^8.13.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.9",
    "vite": "^5.4.0",
    "wrangler": "^4.0.0"
  }
}
